# ---- 缓存与临时文件 ----
__pycache__/
*.pyc
*.tmp
*.swp
# 下载/构建缓存(鸿蒙字体的 zip 就落在这儿)。2026-09-27 审计发现它**没被忽略**:
# 污染 git status, 也容易被顺手提交。pack 早就按基名排除它, 版本库这边却漏了。
.cache/

# ---- 会话/AI 产物(非项目代码) ----
.workbuddy/
todo/

# ---- 第三方二进制(6MB, 不进公开仓库; 想本地用自己放一个到 tools/) ----
# check.sh 第 3 节会自动识别 tools/shellcheck(.exe);
# 若确实希望仓库自带, 删掉下面这行即可。
tools/shellcheck
tools/shellcheck.exe

# ---- 系统杂项 ----
.DS_Store
Thumbs.db

# ---- 发布包(steamos.sh pack 的产物) ----
# 628K 的 tar + 校验和: 属于"构建产物", 不进版本库; 要发布就现打一个。
dist/

# ---- 自愈脚本的运行时状态 ----
# 正常部署时它们落在 ~/.local/opt/steamos-self-heal/; 但若有人直接从仓库目录
# 跑过 self-heal-after-upgrade.sh(或早期版本的 doctor.sh), 会在仓库根留下这几坨。
# 它们是运行时产物, 不该进仓库。
last-osversion
last-report.txt
NEEDS-ATTENTION.txt
