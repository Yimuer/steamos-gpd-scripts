[Desktop Entry]
Type=Application
Version=1.0
Name=重装后先运行我（一键重建环境）
Name[en]=Run me first after SteamOS reinstall
Comment=双击运行 steamos-setup.sh：自动提权、断点续传、逐个重建重装后的环境
# %k = 本 .desktop 文件的路径 → 自动 cd 到脚本所在目录(备份包放哪都能用)。
# 首次运行时把同目录的 .svg 装进用户图标主题(steamos-runme), 之后本项即显示定制图标。
Exec=konsole --hold -e /bin/bash -c 'ic="$HOME/.local/share/icons/hicolor"; mkdir -p "$ic/scalable/apps"; cp -f "$(dirname "%k")/重装后先运行我.svg" "$ic/scalable/apps/steamos-runme.svg" 2>/dev/null; gtk-update-icon-cache -f "$ic" 2>/dev/null; cd "$(dirname "%k")" 2>/dev/null || cd "$HOME/Downloads/steamos-reinstall-backup" || exit 1; bash ./steamos-setup.sh; rc=$?; echo; printf '是否安装可选组件(微信等)? [y/N] '; read -r opt; opt2=跳过; case "$opt" in y|Y|yes|YES) bash ./可选组件安装.sh; opt2="退出码 $?";; esac; echo; echo "──── 结束：必装退出码 $rc / 可选:$opt2 （检查输出后可关闭窗口）────"'
TryExec=konsole
Icon=steamos-runme
Terminal=false
Categories=System;
