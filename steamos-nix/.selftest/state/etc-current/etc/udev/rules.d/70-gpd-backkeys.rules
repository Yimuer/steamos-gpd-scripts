# Managed by the steamos-nix flake — do NOT edit this file directly.
# The real content lives in /nix/store; this is a symlink created by
# `steamos-nix-activate`. Editing /etc copies here will be overwritten on
# the next activation.
#
# Purpose: give the backkeys daemon's virtual keyboard an ID_BUS so the
# gamescope/GPTP input stack treats "GPD Win 5 Back Buttons" like a
# Bluetooth gamepad source (matches the original steamos-setup.sh [4]).
SUBSYSTEM=="input", ATTRS{name}=="GPD Win 5 Back Buttons", ENV{ID_BUS}="bluetooth"
